# Dispo Deals Docker Environment Configuration
# Copy to .env and fill in values

# Discord/Slack webhook URL for Culture Cannabis Club alerts
WEBHOOK_URL=

# FlareSolverr URL (set automatically in docker-compose)
# FLARESOLVERR_URL=http://flaresolverr:8191

# Optional: Log level
LOG_LEVEL=INFO

# Timezone
TZ=America/New_York