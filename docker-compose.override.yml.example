version: '3.8'

# Override for local development (no FlareSolverr needed locally)
# Usage: docker compose -f docker-compose.yml -f docker-compose.override.yml up

services:
  scraper:
    environment:
      # Use cloudscraper locally (no FlareSolverr)
      - FLARESOLVERR_URL=
    volumes:
      # Mount source for live reload
      - .:/app
    command: python main.py

  api:
    volumes:
      - .:/app
    command: python api_server.py --port 4040

  # Disable FlareSolverr locally
  flaresolverr:
    profiles:
      - disabled